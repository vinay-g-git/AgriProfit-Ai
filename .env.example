# --- AI Farm Advisor ---
# Copy this file to `.env` and fill in at least one key to enable the
# AI-generated crop insight and the interactive advisor chat.
# Without any key set, the app still works fully — it just falls back to
# the built-in rule-based explanation instead of an AI one.

# RECOMMENDED / FREE: Groq (https://console.groq.com/keys)
# Groq has a free developer tier — no credit card required. Sign up, create
# an API key, and paste it below. This is the primary/default provider.
GROQ_API_KEY=

# Optional: override the Groq model (defaults to openai/gpt-oss-120b — the
# migration target Groq recommends after deprecating llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: override the Groq vision model used for crop photo analysis
# (defaults to qwen/qwen3.6-27b — Groq's current production vision model,
# after Llama 4 Maverick was decommissioned March 9, 2026). Groq's vision
# lineup changes fairly often — check console.groq.com/docs/vision if this
# stops working.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: override the Groq Whisper model used for voice observation
# transcription (defaults to whisper-large-v3-turbo — fast and free-tier
# friendly). See console.groq.com/docs/speech-to-text for alternatives.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OPTIONAL / PAID FALLBACK: OpenAI (https://platform.openai.com/api-keys)
# The OpenAI API is billed usage — it is NOT free. Only set this if you
# already have an OpenAI account you're happy to use as a backup provider
# in case Groq is unavailable. Leave it blank to stay 100% on the free tier.
# OPENAI_API_KEY=

# Optional: override the OpenAI model (defaults to gpt-4o-mini — already
# vision-capable, so it's also used for crop photo analysis)
# OPENAI_MODEL=gpt-4o-mini

# Optional: override the OpenAI transcription model used as the fallback for
# voice observation transcription (defaults to whisper-1 — OpenAI's only
# transcription model, so there's little reason to change this)
# OPENAI_WHISPER_MODEL=whisper-1
